# Copia este contenido en Streamlit Cloud → tu app → Settings → Secrets.
# (Para probar en tu computador puedes crear .streamlit/secrets.toml; está en .gitignore. NUNCA lo subas.)
# Los valores salen de la llave JSON de la cuenta de servicio de solo lectura (ver README, sección 8).

gcp_project = "tu-proyecto-id"

# Inicio de sesión: solo entran correos de estos dominios (ver README, sección 8.3)
dominios_permitidos = ["andinagroup.com"]

[auth]
redirect_uri = "https://tu-app.streamlit.app/oauth2callback"   # local: http://localhost:8501/oauth2callback
cookie_secret = "un-texto-largo-y-aleatorio"                     # python -c "import secrets; print(secrets.token_hex(32))"
client_id = "....apps.googleusercontent.com"
client_secret = "..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
client_kwargs = { prompt = "select_account", hd = "andinagroup.com" }   # hd: Google muestra solo cuentas del dominio

[gcp_service_account]
type = "service_account"
project_id = "tu-proyecto-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "streamlit-lector@tu-proyecto-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
